# Токен бота, полученный от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# --- Только для продакшена (например, Render) ---
# Если эти переменные заданы, бот работает через webhook вместо long polling.
# На Render НЕ нужно задавать их вручную:
# - PORT Render подставляет сам
# - RENDER_EXTERNAL_URL Render подставляет сам (https://ваш-сервис.onrender.com)
# WEBHOOK_URL нужен, только если разворачиваете не на Render (свой домен и т.п.)
# WEBHOOK_URL=
# WEBHOOK_SECRET=придумайте-свою-секретную-строку
