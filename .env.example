# Токен бота, полученный от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Ключ Gemini API (бесплатно: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Необязательно: модель Gemini (по умолчанию gemini-2.5-flash).
# Если упрётесь в лимиты бесплатного тарифа, попробуйте gemini-2.0-flash.
GEMINI_MODEL=gemini-2.5-flash
